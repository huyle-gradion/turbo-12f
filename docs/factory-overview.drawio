<mxfile host="app.diagrams.net" type="device">
<diagram id="factory" name="Finished factory">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b style='font-size:20px'&gt;turbo-12f: the finished software factory&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;12-Factor Agents · one profile per product (.t12/project.json) · the core never calls a model or the network and never merges · a human approves specs and merges&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="50" as="geometry"/></mxCell>
<mxCell id="people" value="People (the only human touchpoints)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#fffbea;swimlaneFillColor=#fffbea;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2280" height="120" as="geometry"/></mxCell>
<mxCell id="h_spec" value="Spec author (GitHub path)&lt;br&gt;&lt;font style='font-size:10px'&gt;factory-spec skill: given/when/then, Touches, Decisions; spec-check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="people"><mxGeometry x="20" y="40" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="h_label" value="Approve&lt;br&gt;&lt;font style='font-size:10px'&gt;add the &lt;i&gt;factory&lt;/i&gt; label&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="people"><mxGeometry x="290" y="40" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="h_answer" value="Answer an escalation&lt;br&gt;&lt;font style='font-size:10px'&gt;t12 resume --answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="people"><mxGeometry x="900" y="40" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="h_trunk" value="Fix trunk / supersede&lt;br&gt;&lt;font style='font-size:10px'&gt;after a known-red pause&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="people"><mxGeometry x="1500" y="40" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="h_merge" value="Merge the PR&lt;br&gt;&lt;font style='font-size:10px'&gt;local-verified is not acceptance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="people"><mxGeometry x="2030" y="40" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="h_triage" value="Triage findings · apply proposals&lt;br&gt;&lt;font style='font-size:10px'&gt;job issues, retro / calibrate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="people"><mxGeometry x="560" y="40" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="h_profile" value="Edit .t12/project.json&lt;br&gt;&lt;font style='font-size:10px'&gt;protected: no worker may touch .t12/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="people"><mxGeometry x="1180" y="40" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="planner" value="0 · Planner: client specs → reviewed Asana sub-tasks (people + agent, interactive; the core is not involved)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#fdf6ec;swimlaneFillColor=#fdf6ec;strokeColor=#d79b00;fontStyle=1;fontSize=13;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="2280" height="250" as="geometry"/></mxCell>
<mxCell id="client" value="Client&lt;br&gt;&lt;font style='font-size:10px'&gt;provides specs, answers clarifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="planner"><mxGeometry x="20" y="45" width="180" height="65" as="geometry"/></mxCell>
<mxCell id="spec_in" value="Original specs&lt;br&gt;&lt;font style='font-size:10px'&gt;kept as given, versioned&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="20" y="150" width="180" height="75" as="geometry"/></mxCell>
<mxCell id="evaluate" value="1 · Evaluate (senior PM prompt)&lt;br&gt;&lt;font style='font-size:10px'&gt;discrepancies, each quoting the spec&lt;br&gt;score /100 · questions for the client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="240" y="45" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="judge" value="PBT judges each finding&lt;br&gt;&lt;font style='font-size:10px'&gt;correct · evaluate again · ask the client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="planner"><mxGeometry x="240" y="155" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="grill" value="2 · Grill (grill-me / grill-with-docs)&lt;br&gt;&lt;font style='font-size:10px'&gt;agent asks until no knowledge gap&lt;br&gt;answers → Decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="570" y="45" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="pbt_grill" value="PBT answers&lt;br&gt;&lt;font style='font-size:10px'&gt;loop until no gap left or PBT is satisfied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="planner"><mxGeometry x="570" y="155" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="record" value="Planning record&lt;br&gt;&lt;font style='font-size:10px'&gt;spec versions · evaluations&lt;br&gt;judgements · decisions&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="900" y="45" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="asana_task" value="3 · Asana Task (the story)&lt;br&gt;&lt;font style='font-size:10px'&gt;summary · decisions · out of scope&lt;br&gt;never runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="1180" y="45" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="review_story" value="PBT + devs review the Task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="planner"><mxGeometry x="1180" y="155" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="split" value="4 · Generate sub-tasks&lt;br&gt;&lt;font style='font-size:10px'&gt;given/when/then · Touches · ≤10 criteria&lt;br&gt;one test file each · spec-check --forge asana&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="1500" y="45" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="asana_sub" value="Asana sub-tasks&lt;br&gt;&lt;font style='font-size:10px'&gt;one unit of factory work each&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=6 4;" vertex="1" parent="planner"><mxGeometry x="1840" y="45" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="tag" value="PBT adds the approval tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="planner"><mxGeometry x="1840" y="155" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="n_planner" value="PBT = PM · BA · Tech lead.&lt;br&gt;Both loops end only on a human's word (Factor 7)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="planner"><mxGeometry x="900" y="150" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="intake" value="1 · Intake (host adapters)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#f3faf3;swimlaneFillColor=#f3faf3;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="300" height="560" as="geometry"/></mxCell>
<mxCell id="tracker" value="Issue tracker&lt;br&gt;&lt;font style='font-size:10px'&gt;GitHub · GitLab · Asana&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="intake"><mxGeometry x="40" y="45" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="intake_ad" value="Intake adapter&lt;br&gt;&lt;font style='font-size:10px'&gt;github-issues · gitlab-issues · asana-tasks&lt;br&gt;spec-check refuses bad specs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="intake"><mxGeometry x="30" y="140" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="queue" value="Queue dir&lt;br&gt;&lt;font style='font-size:10px'&gt;task files&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="intake"><mxGeometry x="50" y="250" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="t12queue" value="bin/t12-queue&lt;br&gt;&lt;font style='font-size:10px'&gt;admits when deps merged,&lt;br&gt;touches don't overlap, &amp;lt; --max runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="intake"><mxGeometry x="30" y="340" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="n_intake" value="Factor 11: trigger from anywhere.&lt;br&gt;An issue with an open question, an HTML comment or a &lt;i&gt;Depends on&lt;/i&gt; line on GitHub never reaches the queue." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="intake"><mxGeometry x="20" y="445" width="260" height="95" as="geometry"/></mxCell>
<mxCell id="prep" value="2 · Prepare (core)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#f4f7fd;swimlaneFillColor=#f4f7fd;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="520" width="230" height="560" as="geometry"/></mxCell>
<mxCell id="prepare" value="t12 prepare&lt;br&gt;&lt;font style='font-size:10px'&gt;profile read from trunk and frozen&lt;br&gt;worktree + run record&lt;br&gt;budgets: time · ops · repairs · cycles&lt;br&gt;state VERSION 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="prep"><mxGeometry x="15" y="45" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="n_prep" value="The candidate never checks itself: the factory runs from an installed copy of main, and .t12/ changes are flagged to the reviewer." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="prep"><mxGeometry x="15" y="190" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="tdd" value="3 · TDD lane (build, not QC)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#f7f3fa;swimlaneFillColor=#f7f3fa;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="520" width="640" height="560" as="geometry"/></mxCell>
<mxCell id="analyzer" value="analyzer&lt;br&gt;&lt;font style='font-size:10px'&gt;test list covering every&lt;br&gt;acceptance criterion · units&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="tdd"><mxGeometry x="20" y="45" width="180" height="75" as="geometry"/></mxCell>
<mxCell id="red" value="red&lt;br&gt;&lt;font style='font-size:10px'&gt;one failing test, then locked&lt;br&gt;devil pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="tdd"><mxGeometry x="230" y="45" width="170" height="75" as="geometry"/></mxCell>
<mxCell id="green" value="green&lt;br&gt;&lt;font style='font-size:10px'&gt;blind worktree: no tests,&lt;br&gt;no criteria, no bash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="tdd"><mxGeometry x="430" y="45" width="190" height="75" as="geometry"/></mxCell>
<mxCell id="refactor" value="refactor&lt;br&gt;&lt;font style='font-size:10px'&gt;skipped for tiny greens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="tdd"><mxGeometry x="430" y="170" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="tddcheck" value="core runs red tests + lint&lt;br&gt;&lt;font style='font-size:10px'&gt;failure → same role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="tdd"><mxGeometry x="230" y="170" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="lanes" value="parallel lanes&lt;br&gt;&lt;font style='font-size:10px'&gt;units own files · integrate&lt;br&gt;lane → integration → run locks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="tdd"><mxGeometry x="20" y="170" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="final" value="final (tdd-step)&lt;br&gt;&lt;font style='font-size:10px'&gt;all red tests + lint on tip&lt;br&gt;pin the candidate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="tdd"><mxGeometry x="230" y="290" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="n_tdd" value="&lt;b&gt;Workers&lt;/b&gt; are omp sessions over RPC, one session per role (Factor 10). Each ends with one structured host-tool call, checked by tools.py (Factor 4); a refused call goes back to the same session. Skills are pinned per role by commit and sha256 (ponytail, impeccable, humanizer, safe-refactor, vitest…). Any worker may call &lt;i&gt;escalate&lt;/i&gt; → the run pauses for a human (Factor 6/7)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="tdd"><mxGeometry x="20" y="400" width="600" height="140" as="geometry"/></mxCell>
<mxCell id="qc" value="4 · QC (per task)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#f4f7fd;swimlaneFillColor=#f4f7fd;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="520" width="640" height="560" as="geometry"/></mxCell>
<mxCell id="gate_when" value="gate when&lt;br&gt;&lt;font style='font-size:10px'&gt;diff touches globs? #108&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 4;" vertex="1" parent="qc"><mxGeometry x="20" y="45" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="gate_run" value="run gate in cage&lt;br&gt;&lt;font style='font-size:10px'&gt;landlock / docker, offline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="qc"><mxGeometry x="200" y="45" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="gate_rerun" value="reruns → flaky #110&lt;br&gt;&lt;font style='font-size:10px'&gt;advisory → reviewer #109&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=6 4;" vertex="1" parent="qc"><mxGeometry x="400" y="45" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="gate_base" value="base_check #111&lt;br&gt;&lt;font style='font-size:10px'&gt;fails on base too → pause known-red&lt;br&gt;else back to green, 1 repair&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 4;" vertex="1" parent="qc"><mxGeometry x="400" y="140" width="210" height="65" as="geometry"/></mxCell>
<mxCell id="review" value="reviewer (opus, high)&lt;br&gt;&lt;font style='font-size:10px'&gt;quality + security skills&lt;br&gt;verdict per criterion #112&lt;br&gt;project review roles (ux-copy…)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="qc"><mxGeometry x="20" y="170" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="check" value="t12 check&lt;br&gt;&lt;font style='font-size:10px'&gt;re-hash evidence chain, manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="qc"><mxGeometry x="20" y="300" width="220" height="65" as="geometry"/></mxCell>
<mxCell id="lv" value="local-verified" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;" vertex="1" parent="qc"><mxGeometry x="60" y="400" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="n_qc" value="&lt;b&gt;Core&lt;/b&gt;: a mechanism every project needs, deterministic, offline, stdlib, language-free.&lt;br&gt;&lt;b&gt;Profile&lt;/b&gt;: commands and data: gates (suite, e2e, smoke, contract, formal verification), advisory mutation / coverage tools, review roles, skills.&lt;br&gt;&lt;b&gt;Two full suites&lt;/b&gt;: the factory's own runs only when the factory changes; a product's only for that product. test_command stays narrow, the full suite is a gate with &lt;i&gt;when&lt;/i&gt;.&lt;br&gt;Every new key defaults to today's behaviour (#107)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="qc"><mxGeometry x="280" y="250" width="340" height="290" as="geometry"/></mxCell>
<mxCell id="deliv" value="5 · Delivery (host adapters)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#f3faf3;swimlaneFillColor=#f3faf3;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1970" y="520" width="350" height="560" as="geometry"/></mxCell>
<mxCell id="push" value="runner pushes the branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="deliv"><mxGeometry x="30" y="45" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="cr" value="create-pr / create-mr adapter&lt;br&gt;&lt;font style='font-size:10px'&gt;github · gitlab · bitbucket&lt;br&gt;body links the issue; never merges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="deliv"><mxGeometry x="30" y="140" width="290" height="75" as="geometry"/></mxCell>
<mxCell id="deliver" value="t12 deliver&lt;br&gt;&lt;font style='font-size:10px'&gt;report pinned to the reviewed head&lt;br&gt;confirmed · uncertain · rejected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="deliv"><mxGeometry x="30" y="250" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="observe" value="observe merged&lt;br&gt;&lt;font style='font-size:10px'&gt;runner records merges #89&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=6 4;" vertex="1" parent="deliv"><mxGeometry x="30" y="360" width="290" height="65" as="geometry"/></mxCell>
<mxCell id="rt" value="Runtime (host)" style="swimlane;html=1;startSize=26;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#fafafa;swimlaneFillColor=#fafafa;strokeColor=#9aa3b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1550" height="150" as="geometry"/></mxCell>
<mxCell id="runner" value="adapters/runner.py&lt;br&gt;&lt;font style='font-size:10px'&gt;drives each run: context → omp worker → t12 act → gates → review → check → deliver&lt;br&gt;--role-model / --role-thinking · budgets · notify&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="rt"><mxGeometry x="20" y="40" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="omp" value="omp workers (RPC)&lt;br&gt;&lt;font style='font-size:10px'&gt;isolated profile t12-worker · host tools&lt;br&gt;guard.ts: read-only globs, confine, bash deny&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="rt"><mxGeometry x="430" y="40" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="cage" value="Verification cage&lt;br&gt;&lt;font style='font-size:10px'&gt;fresh checkout of the commit · Landlock or Docker&lt;br&gt;no network, no git transport, no home&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="rt"><mxGeometry x="790" y="40" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="board" value="t12 board · status · report&lt;br&gt;&lt;font style='font-size:10px'&gt;phase, candidate, budget left, who acts next&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="rt"><mxGeometry x="1150" y="40" width="380" height="90" as="geometry"/></mxCell>
