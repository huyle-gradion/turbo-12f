#!/usr/bin/env python3
"""The builder's cage: resolves the package from its own location.

  t12-cage --home H --task-id ID -- COMMAND [ARG...]
  t12-cage commit --home H --task-id ID --message M
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from t12.cage import main  # noqa: E402

raise SystemExit(main())
